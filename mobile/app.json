{
  "expo": {
    "name": "Nova",
    "slug": "nova",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7353d6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Nova folosește camera pentru actul de identitate și selfie.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nova importă doar fotografiile actului pe care le alegi.",
          "cameraPermission": "Nova folosește camera pentru actul de identitate și selfie.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ],
    "scheme": "nova"
  }
}
